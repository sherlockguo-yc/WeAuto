# WeAuto 凭据模板
#
# 使用步骤：
#   1. 复制本文件为 .env.local
#   2. 填入下方字段
#   3. age -e -r <公钥> -o secrets.age .env.local
#   4. 删除 .env.local（明文不应长期存在）
#
# 运行时由 src/secrets.mjs 调用 age 解密到内存，明文不落盘。

V2FREE_EMAIL=
V2FREE_PASSWORD=

# 若账号开启了两步验证（TOTP），填入 base32 secret；未开启则留空。
# 留空时登录请求不会携带 code 字段。
V2FREE_TOTP_SECRET=
